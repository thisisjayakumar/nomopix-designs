{
  "name": "nomopix-website",
  "version": "1.0.0",
  "description": "NOMOPIX - Stunning 3D Business Website",
  "main": "server/index.js",
  "scripts": {
    "client": "cd client && npm start",
    "server": "NODE_NO_WARNINGS=1 nodemon server/index.js",
    "dev": "NODE_NO_WARNINGS=1 concurrently \"npm run server\" \"npm run client\"",
    "start": "node server/index.js",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd client && npm install"
  },
  "keywords": [
    "nomopix",
    "website",
    "3d",
    "business"
  ],
  "author": "NOMOPIX",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "http-proxy-middleware": "^3.0.5",
    "nodemon": "^3.0.2"
  }
}
